---
interface Props {
  caption?: string
  alt?: string
}

const { caption, alt = '' } = Astro.props
---

<figure class="diagram">
  <div class="diagram-inner" role="img" aria-label={alt}>
    <button class="diagram-expand" type="button" aria-label="View diagram fullscreen">⤢</button>
    <slot />
  </div>
  {caption && <figcaption class="diagram-caption">{caption}</figcaption>}
</figure>

<script>
  const state = {
    scale: 1,
    x: 0,
    y: 0,
    dragging: false,
    startX: 0,
    startY: 0,
    content: null as HTMLElement | null,
  }

  const MIN_SCALE = 1
  const MAX_SCALE = 6

  function applyTransform() {
    if (!state.content) return
    state.content.style.transform = `translate(${state.x}px, ${state.y}px) scale(${state.scale})`
  }

  function setScale(next: number) {
    state.scale = Math.min(MAX_SCALE, Math.max(MIN_SCALE, next))
    if (state.scale === MIN_SCALE) {
      state.x = 0
      state.y = 0
    }
    applyTransform()
  }

  function resetTransform() {
    state.scale = 1
    state.x = 0
    state.y = 0
    applyTransform()
  }

  function closeViewer() {
    const viewer = document.querySelector('.diagram-viewer')
    if (!viewer) return
    viewer.remove()
    document.body.style.overflow = ''
    state.content = null
  }

  function openViewer(inner: Element) {
    const viewer = document.createElement('div')
    viewer.className = 'diagram-viewer'
    viewer.innerHTML = `
      <div class="diagram-viewer-toolbar">
        <button type="button" class="diagram-viewer-zoom-out" aria-label="Zoom out">−</button>
        <button type="button" class="diagram-viewer-reset" aria-label="Reset zoom">Reset</button>
        <button type="button" class="diagram-viewer-zoom-in" aria-label="Zoom in">+</button>
        <button type="button" class="diagram-viewer-close" aria-label="Close">✕</button>
      </div>
      <div class="diagram-viewer-frame"></div>
    `

    const frame = viewer.querySelector('.diagram-viewer-frame') as HTMLElement
    const content = document.createElement('div')
    content.className = 'diagram-viewer-content'
    Array.from(inner.children).forEach(child => {
      if (child.classList.contains('diagram-expand')) return
      content.appendChild(child.cloneNode(true))
    })
    frame.appendChild(content)
    document.body.appendChild(viewer)
    document.body.style.overflow = 'hidden'

    state.content = content
    state.scale = 1
    state.x = 0
    state.y = 0
    applyTransform()

    frame.addEventListener(
      'wheel',
      e => {
        e.preventDefault()
        setScale(state.scale * (e.deltaY < 0 ? 1.15 : 1 / 1.15))
      },
      { passive: false }
    )

    content.addEventListener('pointerdown', e => {
      state.dragging = true
      state.startX = e.clientX - state.x
      state.startY = e.clientY - state.y
      content.setPointerCapture(e.pointerId)
    })
    content.addEventListener('pointermove', e => {
      if (!state.dragging) return
      state.x = e.clientX - state.startX
      state.y = e.clientY - state.startY
      applyTransform()
    })
    content.addEventListener('pointerup', () => {
      state.dragging = false
    })
  }

  document.addEventListener('click', e => {
    const target = e.target as HTMLElement

    const expandBtn = target.closest('.diagram-expand')
    if (expandBtn) {
      const inner = expandBtn.closest('.diagram-inner')
      if (inner) openViewer(inner)
      return
    }

    if (target.closest('.diagram-viewer-zoom-in')) {
      setScale(state.scale * 1.25)
      return
    }
    if (target.closest('.diagram-viewer-zoom-out')) {
      setScale(state.scale / 1.25)
      return
    }
    if (target.closest('.diagram-viewer-reset')) {
      resetTransform()
      return
    }
    if (target.closest('.diagram-viewer-close')) {
      closeViewer()
      return
    }
    if (target.classList.contains('diagram-viewer')) {
      closeViewer()
    }
  })

  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') closeViewer()
  })
</script>

<style>
  .diagram {
    margin: 2.5rem 0;
  }

  .diagram-inner {
    position: relative;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 2rem;
    overflow-x: auto;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .diagram-inner :global(svg),
  .diagram-inner :global(img) {
    max-width: 100%;
    height: auto;
  }

  .diagram-expand {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    color: var(--color-muted);
    font-size: 13px;
    line-height: 1;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
  }

  .diagram-expand:hover {
    color: var(--color-accent);
    border-color: var(--color-border-hover);
  }

  .diagram-caption {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-muted);
    letter-spacing: 0.04em;
    text-align: center;
    margin-top: 0.75rem;
  }

  :global(.diagram-viewer) {
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: rgba(0, 0, 0, 0.92);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  :global(.diagram-viewer-toolbar) {
    position: absolute;
    top: 1rem;
    right: 1rem;
    z-index: 1001;
    display: flex;
    gap: 0.5rem;
  }

  :global(.diagram-viewer-toolbar button) {
    min-width: 32px;
    height: 32px;
    padding: 0 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: 13px;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
  }

  :global(.diagram-viewer-toolbar button:hover) {
    color: var(--color-accent);
    border-color: var(--color-border-hover);
  }

  :global(.diagram-viewer-frame) {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  :global(.diagram-viewer-content) {
    max-width: 90vw;
    max-height: 85vh;
    cursor: grab;
    touch-action: none;
    transform-origin: center center;
    will-change: transform;
  }

  :global(.diagram-viewer-content:active) {
    cursor: grabbing;
  }

  :global(.diagram-viewer-content svg),
  :global(.diagram-viewer-content img) {
    display: block;
    max-width: 90vw;
    max-height: 85vh;
    width: auto;
    height: auto;
    user-select: none;
    pointer-events: none;
  }
</style>
